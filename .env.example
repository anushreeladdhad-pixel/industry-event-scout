# --- Required for live AI scoring / extraction (Gemini Flash only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Email delivery (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=Event Scout <onboarding@resend.dev>
DIGEST_TO=vikram@example.com

# --- Security (all fail CLOSED if unset) ---
ADMIN_TOKEN=            # protects /api/send and saving settings
CRON_SECRET=            # Vercel sends this as a Bearer token to /api/cron

# --- Config storage (Supabase REST). If unset, defaults are used and settings are read-only ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
